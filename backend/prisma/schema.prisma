// Becho — Prisma Schema
// Prisma 7: url is configured in prisma.config.ts, NOT here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────

enum UserRole {
  BUYER
  SELLER
}

enum ListingType {
  ONLINE
  OFFLINE
}

enum ListingStatus {
  ACTIVE
  SOLD
  HIDDEN
}

enum PurchaseRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum NotificationType {
  PURCHASE_REQUEST
  PURCHASE_ACCEPTED
  PURCHASE_DECLINED
}

// ─── Models ─────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String? // null for Google-only accounts
  googleId     String?  @unique
  name         String
  role         UserRole @default(BUYER)
  isVerified   Boolean  @default(false)
  reputation   Float    @default(0)
  collegeId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings         Listing[]
  mentorships      Mentorship[]
  sentMessages     Message[]           @relation("SentMessages")
  receivedMessages Message[]           @relation("ReceivedMessages")
  refreshTokens    RefreshToken[]
  buyerRequests    PurchaseRequest[]   @relation("BuyerRequests")
  sellerRequests   PurchaseRequest[]   @relation("SellerRequests")
  notifications    InboxNotification[] @relation("UserNotifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Float         @default(0)
  type        ListingType
  category    String
  subject     String?
  semester    Int?
  condition   String? // for offline items
  isFree      Boolean       @default(false)
  status      ListingStatus @default(ACTIVE)
  images      String[] // Postgres native array of image URLs
  fileUrl     String? // for digital downloads (ONLINE type)
  qrCodeUrl   String? // optional payment QR (UPI / bank) for offline listings

  sellerId         String
  seller           User              @relation(fields: [sellerId], references: [id])
  messages         Message[]
  purchaseRequests PurchaseRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mentorship {
  id          String   @id @default(uuid())
  subject     String
  description String
  hourlyRate  Float    @default(0)
  tags        String[] // e.g. ["DSA", "DBMS", "Web Dev"]
  isActive    Boolean  @default(true)
  mentorId    String
  mentor      User     @relation(fields: [mentorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  listingId  String? // optional: message tied to a specific listing chat
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  listing    Listing? @relation(fields: [listingId], references: [id])
  createdAt  DateTime @default(now())
}

// ─── Purchase Request System ─────────────────────────────────────

model PurchaseRequest {
  id        String                @id @default(uuid())
  listingId String
  listing   Listing               @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User                  @relation("BuyerRequests", fields: [buyerId], references: [id])
  sellerId  String
  seller    User                  @relation("SellerRequests", fields: [sellerId], references: [id])
  status    PurchaseRequestStatus @default(PENDING)
  note      String? // optional message from buyer
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  notifications InboxNotification[]
}

model InboxNotification {
  id                String           @id @default(uuid())
  userId            String // recipient
  user              User             @relation("UserNotifications", fields: [userId], references: [id])
  type              NotificationType
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  isRead            Boolean          @default(false)
  createdAt         DateTime         @default(now())
}
